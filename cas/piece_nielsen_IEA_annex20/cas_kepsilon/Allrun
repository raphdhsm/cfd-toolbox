#!/bin/bash
# Lance le cas A (k-epsilon) de la piece de Nielsen. A executer dans ce dossier.
set -e
blockMesh   > log.blockMesh   2>&1 && echo "1/3 maillage OK"
checkMesh   > log.checkMesh   2>&1 && echo "2/3 checkMesh OK"
echo "3/3 calcul en cours (suivi : tail -f log.foamRun)..."
foamRun     > log.foamRun     2>&1
echo "Calcul termine. Derniere iteration :"
grep "^Time =" log.foamRun | tail -1
