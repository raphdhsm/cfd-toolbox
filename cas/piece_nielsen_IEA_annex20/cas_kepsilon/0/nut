/*--------------------------------*- C++ -*----------------------------------*\
  Piece ventilee de Nielsen (IEA Annex 20) - cas A : k-epsilon + lois de paroi
  OpenFOAM 13 (openfoam.org)
\*---------------------------------------------------------------------------*/
FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Viscosite turbulente (m2/s), calculee par le modele : nut = Cmu k^2 / epsilon
dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            calculated;
        value           uniform 0;
    }
    outlet
    {
        type            calculated;
        value           uniform 0;
    }
    walls
    {
        type            nutkWallFunction;   // loi de paroi basee sur k
        value           uniform 0;
    }
    frontAndBack
    {
        type            empty;
    }
}

// ************************************************************************* //
